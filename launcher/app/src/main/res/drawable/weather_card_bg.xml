<?xml version="1.0" encoding="utf-8"?>
<!-- Approximate glass for the weather card: flat fill, rim and corner. The real surface is drawn by
     GlassView (fill + specular + rim + glow) in a later pass; this shape is enough to place the card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#38FFFFFF" />
    <corners android:radius="22dp" />
</shape>
