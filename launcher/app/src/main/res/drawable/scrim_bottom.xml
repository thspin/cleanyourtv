<?xml version="1.0" encoding="utf-8"?>
<!-- Legibility scrim over the lower band of the home: transparent at the top, opaque at the bottom edge,
     where the action row sits. angle 90 runs bottom to top, so startColor is the bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#B3000000"
        android:centerColor="#66000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
